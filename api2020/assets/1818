local b = game:GetService(&quot;BadgeService&quot;)

function takeAction()
&#9;player.Reward.Display.Value = false
&#9;script.Parent.Show.Value = true
&#9;--Calculate points
&#9;datbutton = math.floor(player.Reward.Buttons.Value/3)
&#9;reward = player.Reward.Progress.Value + datbutton + player.Reward.Difficulty.Value
&#9;if GamePassService:PlayerHasPass(player, 113061413) then
&#9;&#9;reward = math.floor(reward*1.5)
&#9;&#9;script.Parent.Booster.Visible = true
&#9;end
&#9;player.leaderstats.Points.Value = player.leaderstats.Points.Value + reward
&#9;--Update Text
&#9;script.Parent.ProgressionNumber.Text = player.Reward.Progress.Value
&#9;script.Parent.ButtonsNumber.Text = datbutton
&#9;script.Parent.DifficultyNumber.Text = player.Reward.Difficulty.Value
&#9;script.Parent.TotalNumber.Text = reward
&#9;--Badge Awarding
&#9;if datbutton &gt;= 2 then
&#9;&#9;b:AwardBadge(player.userId, 114540869) --Button Masher
&#9;end
&#9;if player:findFirstChild(&quot;AWARDEXTREME&quot;) then
&#9;&#9;b:AwardBadge(player.userId, 114541972) --Extreme
&#9;&#9;player.AWARDEXTREME:Destroy()
&#9;end
&#9;--Reset stats to correctly count for next game
&#9;wait(1) -- Put wait incase code decides to screw up
&#9;player.Reward.Progress.Value = 0
&#9;player.Reward.Buttons.Value = 0
&#9;player.Reward.Difficulty.Value = 0
end

player.Reward.Buttons.Changed:connect(function(howmany)
&#9;if howmany == 6 then
&#9;&#9;script.Parent.Parent.Transition.Infoo.Value = &quot;6 Buttons Pressed - Bonus Round Enabled!&quot;
&#9;end
end)

player.Reward.Display.Changed:connect(function(val)
&#9;if val == true and player.Character.Humanoid.Health ~= 0 then
&#9;&#9;takeAction()
&#9;end
end)

if player.Reward.Display.Value == true then
&#9;takeAction()
end</ProtectedString>
