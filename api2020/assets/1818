&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent[toolstoremove[itemsearch]]:Destroy()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if game.Players[hit.Parent.Name].Backpack:findFirstChild(toolstoremove[itemsearch]) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Players[hit.Parent.Name].Backpack[toolstoremove[itemsearch]]:Destroy()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;game.Players[hit.Parent.Name].Waiting.Value = 2
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Waiting.Value = script.Parent.Parent.Waiting.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Torso.CFrame = script.Parent.Parent.Lift.CFrame + Vector3.new(0, 3.5, 0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;game.Players[hit.Parent.Name].PlayerGui.ScreenGui.Transition.Infoo.Value = &quot;Cannot enter Lift - Too Many Players!&quot;
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end</ProtectedString>
