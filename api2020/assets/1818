function timeToSpectate(who)
&#9;if game.Workspace:findFirstChild(who) then
&#9;&#9;button.Toggle.Value = false 
&#9;&#9;game.Workspace.CurrentCamera.CameraSubject = game.Players[who].Character.Humanoid
&#9;&#9;button.Text = &quot;SPECTATING&quot;
&#9;&#9;--button:TweenSize(UDim2.new(button.Size.X.Scale, 0, 0, 40), &quot;Out&quot;, &quot;Quad&quot;, 0.5, true)
&#9;&#9;for index, child in pairs(button:GetChildren()) do
&#9;&#9;&#9;if child:IsA(&quot;TextButton&quot;) or child:IsA(&quot;TextLabel&quot;) then
&#9;&#9;&#9;&#9;child.Visible = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;old = button.Info.Text
&#9;&#9;button.Info.Text = &quot;Unable to Spectate&quot;
&#9;&#9;wait(2)
&#9;&#9;if button.Info.Text == &quot;Unable to Spectate&quot; then
&#9;&#9;&#9;button.Info.Text = old
&#9;&#9;end
&#9;end
end
&#9;&#9;

function updateList(checkit)
&#9;button.Info.Visible = true
&#9;for boxes=1,10 do --Resets so it can scan again
&#9;&#9;button[&quot;Player&quot;..boxes].Visible = false
&#9;&#9;button[&quot;Player&quot;..boxes].Text = &quot;&quot;
&#9;end
&#9;for i,k in pairs(game.Players:GetPlayers()) do --Scans and updates list
&#9;&#9;if k.Ingame.Value == checkit then
&#9;&#9;&#9;for make=1,10 do
&#9;&#9;&#9;&#9;if button[&quot;Player&quot;..make].Text == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;button[&quot;Player&quot;..make].Text = k.Name
&#9;&#9;&#9;&#9;&#9;button[&quot;Player&quot;..make].Visible = true
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end 
&#9;end
end
&#9;
