local verifiedListReady = false

------------------------------- VERIFIED BADGE --------------------------------
-- Renders a small blue checkmark BillboardGui above each verified user's head.
-- The list of verified userIds (currently the staff list) is fetched on
-- startup. When a player joins or respawns we attach the badge to their head.
local function buildVerifiedBadge()
	-- Standalone BillboardGui (not parented yet). Cloned per character.
	local gui = Instance.new("BillboardGui")
	gui.Name = "VerifiedBadge"
	gui.AlwaysOnTop = true
	gui.Size = UDim2.new(0, 28, 0, 28)
	gui.StudsOffset = Vector3.new(0.9, 2.6, 0)
	gui.SizeOffset = Vector2.new(0, 0)

	-- Blue rounded background. UICorner is unavailable on this engine,
	-- so we fake a circle with an ImageLabel using the canonical Roblox
	-- white circle asset, tinted blue.
	local bg = Instance.new("ImageLabel")
	bg.Name = "Bg"
	bg.BackgroundTransparency = 1
	bg.Size = UDim2.new(1, 0, 1, 0)
	-- White circle decal (built into client textures for old releases)
	bg.Image = "rbxasset://textures/whiteCircle.png"
	bg.ImageColor3 = Color3.new(31/255, 130/255, 224/255) -- Zekoro blue
	bg.Parent = gui

	local check = Instance.new("TextLabel")
	check.Name = "Check"
	check.BackgroundTransparency = 1
	check.Size = UDim2.new(1, 0, 1, 0)
	check.Position = UDim2.new(0, 0, 0, -1)
	check.Text = "\226\156\147" -- UTF-8 for ✓ (U+2713)
	check.TextColor3 = Color3.new(1, 1, 1)
	check.Font = Enum.Font.SourceSansBold
	check.TextScaled = true
	check.TextStrokeTransparency = 0.7
	check.Parent = gui

	return gui
end

local function attachBadgeToCharacter(character)
	if character == nil then return end
	local head = character:FindFirstChild("Head")
	if head == nil then
		-- Wait for Head to be added (R6/R15 spawn race)
		local startedAt = tick()
		while head == nil and (tick() - startedAt) < 5 do
			wait(0.1)
			head = character:FindFirstChild("Head")
		end
		if head == nil then return end
	end
	-- Avoid duplicate badges on respawn races
	local existing = head:FindFirstChild("VerifiedBadge")
	if existing ~= nil then return end
	local badge = buildVerifiedBadge()
	badge.Parent = head
end

-- Prepends a checkmark to the player's DisplayName so the native player
-- list (Tab menu), chat, and overhead nametag all render a verified badge
-- without any client modifications. The 2020 client renders DisplayName
-- everywhere a Player.Name would otherwise appear.
local VERIFIED_PREFIX = "\226\156\147 " -- "✓ " (U+2713 + space)
local function applyVerifiedDisplayName(player)
	pcall(function()
		local current = player.DisplayName
		-- DisplayName may not exist on very old engines; fall back to Name.
		if current == nil or current == "" then current = player.Name end
		if string.sub(current, 1, #VERIFIED_PREFIX) == VERIFIED_PREFIX then
			return -- already prefixed
		end
		player.DisplayName = VERIFIED_PREFIX .. current
	end)
end

local function maybeGiveBadge(player)
	if player == nil then return end
	-- Wait briefly for the staff list to load before deciding.
	local startedAt = tick()
	while adminsList == nil and (tick() - startedAt) < 10 do
		wait(0.2)
	end
	if adminsList == nil then return end
	if not adminsList[player.userId] then return end

	-- 1. Player-list / chat / overhead badge via DisplayName prefix.
	applyVerifiedDisplayName(player)

	-- 2. Overhead BillboardGui badge above the head.
	pcall(function()
		if player.Character then
			attachBadgeToCharacter(player.Character)
		end
	end)
	pcall(function()
		player.CharacterAdded:connect(function(character)
			attachBadgeToCharacter(character)
		end)
	end)
end
