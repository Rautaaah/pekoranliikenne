cmds.viewprofile = function(s, a)
	local id = tonumber(a[1]); if id == nil then adminNotify(s, "viewprofile", "Usage: ;viewprofile <userid>"); return end
	local ok, resp = postAdmin("/gs/admin/viewprofile", {actorUserId = s.userId, targetUserId = id})
	if ok and resp and resp.ok then
		local lines = {
			tostring(resp.username or "?") .. " (" .. tostring(resp.userId or id) .. ")",
			"Status: " .. tostring(resp.status or "?"),
			"R$ " .. tostring(resp.robux or 0) .. "  T$ " .. tostring(resp.tickets or 0),
			(resp.isOwner and "OWNER" or (resp.isStaff and "STAFF" or "user")),
		}
		adminNotify(s, "profile " .. id, table.concat(lines, "\n"))
	else adminNotify(s, "viewprofile", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.cmds = function(s, a)
	adminNotify(s, "Commands", "ban unban kick mute unmute warn logs\ngiveitem removeitem givecurrency removecurrency resetinventory\nteleport bring goto refresh resetcharacter forceavatarreload\nshutdown announce setrank removerank whitelist unwhitelist\nviewprofile maintenance lockserver unlockserver fly unfly")
end

local function processAdminCommand(player, message)
	-- Accept either ";" (IY default) or ":" (matches the legacy staff
	-- mod-command prefix users have muscle-memory for). The first char is
	-- consumed and the remainder is parsed identically. ";cmds" / ":cmds"
	-- both work; ":ban <userid>" reaches the admin handler when the actor
	-- is in the {180, 4} allowlist (staff still gets ":ban <name>" via
	-- processModCommand because that branch parses partial names, not ids).
	local first = string.sub(message, 1, 1)
	if first ~= ";" and first ~= ":" then return end
	print("[admin] chat " .. tostring(player.userId) .. " (" .. tostring(player.Name) .. ") -> " .. tostring(message))
	-- Lazy-fetch the owner list on the first admin-prefix message we see.
	-- Doing it here (rather than at script load) keeps the script chunk
	-- crash-free during DataModel boot.
	ensureAdminOwners()
	if not isAdmin(player) then
		print("[admin] reject: userId " .. tostring(player.userId) .. " is not in allowlist")
		return
	end
	local body = string.sub(message, 2)
	local parts = {}
	for w in string.gmatch(body, "%S+") do table.insert(parts, w) end
	if #parts == 0 then return end
	local cmd = string.lower(parts[1]); local args = {}
	for i = 2, #parts do args[#args + 1] = parts[i] end
	local handler = cmds[cmd]
	if handler == nil then adminNotify(player, cmd, "Unknown. Try ;cmds"); return end
	local ok, err = pcall(function() handler(player, args) end)
	if not ok then
		print("[admin] handler error: " .. tostring(err))
		adminNotify(player, cmd, "Error: " .. tostring(err), Color3.new(1, 0.3, 0.3))
	end
end

local function isMaintenanceBlocking(player)
	return maintenanceMode and not isAdmin(player)
end
-------------------------------------------------------------------------------

local bannedIds = {}

local function processModCommand(sender, message)
	if string.sub(message, 1, 5) == ":ban " then
		local userToBan = string.sub(string.lower(message), 6)
		local player = nil
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			local name = string.sub(string.lower(p.Name), 1, string.len(userToBan))
			if name == userToBan and p ~= sender then
				player = p
				break
			else
				print("Not a match!",name,"vs",userToBan)
			end
		end
		print("ban", player, userToBan)
		if player ~= nil then
			player:Kick("Banned from this server by an administrator")
			bannedIds[player.userId] = {
				["Name"] = player.Name, -- for unban
			}
		end
	end
	if string.sub(message, 1, 7) == ":unban " then
		local userToBan = string.sub(string.lower(message), 8)
		local userId = nil
		for id, data in pairs(bannedIds) do
			local name = string.sub(string.lower(data.Name), 1, string.len(userToBan))
			if name == userToBan then
				userId = id
				break
			end
		end
		print("ban", userId)
		if userId ~= nil then
			table.remove(bannedIds, userId)
		end
	end
end

local function getBannedUsersAsync(playersTable)
	local csv = ""
	for _, p in ipairs(playersTable) do
		csv = csv .. "," .. tostring(p.userId)
	end
	if csv == "" then return end
	csv = string.sub(csv, 2)

	local url = "Users/GetBanStatus.ashx?userIds=" .. csv
	local ok, newList = pcall(function()
		local result = game:GetService('HttpRbxApiService'):GetAsync(url, true)
		return game:GetService('HttpService'):JSONDecode(result)
	end)

	if not ok then
		print("getBannedUsersAsync failed because",newList)
		return
	end

	local ok, banProcErr = pcall(function()
		for _, entry in ipairs(newList) do
			if entry.isBanned then
				local inGame = game:GetService("Players"):GetPlayerByUserId(entry.userId)
				if inGame ~= nil then
					inGame:Kick("Account restriction. Visit our website for more information.")
				end
			end
		end
	end)
	if not ok then
		print("[error] could not process ban result",banProcErr)
	end
end
local hasNoPlayerCount = 0
spawn(function()
	while true do
		wait(30)
		print("Checking banned players...")
		if #game:GetService("Players"):GetPlayers() == 0 then
			print("[warn] no players. m=",hasNoPlayerCount)
			serverOk = false
			hasNoPlayerCount = hasNoPlayerCount + 1
		else
			print("game has players, reset mod")
			hasNoPlayerCount = 0
		end
		if hasNoPlayerCount >= 3 then
			print("Server has had no players for over 1.5m, attempt shutdown")
			pcall(function()
				shutdown()
			end)
		end
		getBannedUsersAsync(game:GetService("Players"):GetPlayers())
	end
end)

game:GetService("Players").PlayerAdded:connect(function(player)
	playersJoin = playersJoin + 1;
	print("Player " .. player.userId .. " added")
    reportPlayerEvent(player.userId, "Join")

	if bannedIds[player.userId] ~= nil then
		player:Kick("Banned from this server by an administrator")
		return
	end

	-- Maintenance mode: only admins can join while it's on. Everyone else
	-- gets the configured reason and is bounced. ;lockserver gives the same
	-- behaviour with a fixed reason.
	if isMaintenanceBlocking(player) then
		delay(0.1, function()
			pcall(function() player:Kick(maintenanceReason or "Server is under maintenance") end)
		end)
		return
	end
	if serverLocked and not isAdmin(player) then
		delay(0.1, function()
			pcall(function() player:Kick("Server is locked") end)
		end)
		return
	end

	-- LOUD DIAGNOSTIC: log every Chatted event unconditionally so we can
	-- verify (a) the new gameserver.lua is the one running in RCC and
	-- (b) Player.Chatted is actually firing at all on this build.
	print("[admin] subscribing Chatted for " .. tostring(player.Name) .. " (userId " .. tostring(player.userId) .. ", isAdmin=" .. tostring(isAdmin(player)) .. ")")
	player.Chatted:connect(function(message)
		print("[admin] Chatted from " .. tostring(player.Name) .. " (" .. tostring(player.userId) .. "): " .. tostring(message))
		-- ;mute keeps the player here but silences anything they say (other
		-- than admin commands they're allowed to run).
		if mutedUserIds[player.userId] and not isAdmin(player) then
			pcall(function()
				if player.Character then
					local head = player.Character:FindFirstChild("Head")
					if head then
						game:GetService("Chat"):Chat(head, "[muted]", Enum.ChatColor.Red)
					end
				end
			end)
			return
		end
		-- Legacy staff commands (":ban <name>", ":unban <name>") for the
		-- staff list pulled from ListStaff.ashx.
		if adminsList ~= nil and adminsList[player.userId] ~= nil then
			processModCommand(player, message)
		end
		-- New IY-style admin commands (";cmd args" or ":cmd args"); the
		-- allowlist is OwnerUserId from appsettings.json (refreshed every
		-- few minutes via /gs/admin/owners).
		processAdminCommand(player, message)
	end)

	-- Attach the blue verified-badge BillboardGui above the head if the
	-- joining user is on the staff/verified list. Fires asynchronously so
	-- it doesn't block the rest of the join handler.
	spawn(function() maybeGiveBadge(player) end)
end)

game:GetService("Players").PlayerRemoving:connect(function(player)
	print("Player " .. player.userId .. " leaving")
    reportPlayerEvent(player.userId, "Leave")
	-- IMPORTANT: PlayerRemoving fires *before* the player is removed from
	-- :GetPlayers(), so a naive `#GetPlayers() == 0` check is always false
	-- when the last player leaves. Count everyone except the leaving
	-- player ourselves, otherwise the RCC stays alive forever and the
	-- website keeps reporting the place as "InGame".
	local remaining = 0
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		if p ~= player then
			remaining = remaining + 1
		end
	end
	if remaining == 0 then
		shutdown();
	end
end)

if placeId~=nil and url~=nil then
	-- yield so that file load happens in the heartbeat thread
	wait()

	-- load the game
	game:Load(url .. "/asset/?id=" .. placeId)
end

-- initCharPositionHack()

-- Now start the connection
ns:Start(port)

scriptContext:SetTimeout(10)
scriptContext.ScriptsDisabled = false



------------------------------END START GAME SHARED SCRIPT--------------------------



-- StartGame --
game:GetService("RunService"):Run()

serverOk = true;
coroutine.wrap(function()
	pollToReportActivity()
end)()
-- kill server if nobody joins within 2m of creation
delay(120, function()
	if playersJoin == 0 then
		serverOk = false
		shutdown();
	end
end)

print("[info] gameserver.txt end");
