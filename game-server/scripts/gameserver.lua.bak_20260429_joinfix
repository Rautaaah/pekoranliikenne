spawn(function()
	local ok, newList = pcall(function()
		local result = game:GetService('HttpRbxApiService'):GetAsync("Users/ListStaff.ashx", true)
		return game:GetService('HttpService'):JSONDecode(result)
	end)
	if not ok then
		print("GetStaff failed because",newList)
		return
	end
	pcall(function()
		adminsList = {}
		adminsList[12] = true -- 12 is hard coded as admin but doesn't show badge
		for i,v in ipairs(newList) do
			adminsList[v] = true
		end
		verifiedListReady = true
		-- Back-fill badges for players who joined before the list arrived.
		for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
			spawn(function() maybeGiveBadge(p) end)
		end
	end)
end)

------------------------------- ADMIN COMMANDS --------------------------------
-- IY-style chat-prefix admin module. The allowlist is the OwnerUserId array
-- from the website's appsettings.json, fetched on RCC startup via
-- GET /gs/admin/owners and refreshed every couple of minutes so editing the
-- config file is the single source of truth across every game on the
-- platform. Commands accept ";" or ":" prefix (e.g. ";fly", ";ban 1234 spam").
-- Server-side actions hit /gs/admin/* with the orchestrator auth and the
-- actor userId baked into the body; the website re-verifies the actor is an
-- owner before doing anything privileged.
print("[admin] module loading; will fetch owner list from /gs/admin/owners")
local ADMIN_USERIDS = {}
local ADMIN_OWNERS_FETCHED = false

-- Lazy-fetch the owner list on demand. We deliberately do NOT kick off a
-- fetch (or any HTTP at all) at script load: this RCC build appears to
-- behave erratically when game:HttpPost / HttpGet is invoked from a
-- top-level spawn() before the DataModel is fully ready, and a failure
-- there manifests as the whole RCC process exiting code 1 right after
-- "job opened" - taking down the entire game with no useful log line.
--
-- Instead the first admin-command attempt triggers the fetch and we
-- re-fetch lazily after ADMIN_OWNERS_TTL seconds so config changes still
-- propagate without an orchestrator restart.
local ADMIN_OWNERS_TTL = 180
local ADMIN_OWNERS_LAST_FETCH = 0

local function refreshAdminOwners()
	-- Try POST first (we know game:HttpPost exists on this RCC build), then
	-- fall back to game:HttpGet for older website deployments where the
	-- /gs/admin/owners route is GET-only. Whichever returns a body wins.
	local payload = http:JSONEncode({ ping = "owners" })
	local response
	local ok = pcall(function()
		response = game:HttpPost(url .. "/gs/admin/owners", payload, false, "application/json")
	end)
	if not ok or response == nil or response == "" then
		ok = pcall(function()
			response = game:HttpGet(url .. "/gs/admin/owners", true)
		end)
	end
	if not ok or response == nil or response == "" then
		print("[admin] failed to fetch owner list: " .. tostring(response))
		return false
	end
	local decoded
	pcall(function() decoded = http:JSONDecode(response) end)
	if decoded == nil or decoded.owners == nil then
		print("[admin] owner list response had no 'owners' field: " .. tostring(response))
		return false
	end
	local newSet = {}
	local count = 0
	for _, id in ipairs(decoded.owners) do
		local n = tonumber(id)
		if n then newSet[n] = true; count = count + 1 end
	end
	ADMIN_USERIDS = newSet
	ADMIN_OWNERS_FETCHED = true
	ADMIN_OWNERS_LAST_FETCH = tick()
	print("[admin] owner list refreshed; " .. tostring(count) .. " admins")
	return true
end

local function ensureAdminOwners()
	if not ADMIN_OWNERS_FETCHED or (tick() - ADMIN_OWNERS_LAST_FETCH) > ADMIN_OWNERS_TTL then
		pcall(refreshAdminOwners)
	end
end

local function isAdmin(player)
	return player ~= nil and ADMIN_USERIDS[player.userId] == true
end

-- IY-style toast: dark rounded card, coloured accent strip, ~4s fade.
-- Always also prints to the RCC console (visible in `docker logs` /
-- orchestrator stdout) and posts a chat-bubble above the player's head as
-- a fallback in case PlayerGui parenting fails on this RCC build.
local function adminNotify(player, title, message, color)
	if player == nil then return end
	print("[admin] notify -> " .. tostring(player.Name) .. " | " .. tostring(title) .. ": " .. tostring(message))
	pcall(function()
		if player.Character then
			local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Torso")
			if head then
				game:GetService("Chat"):Chat(head, "[" .. title .. "] " .. message, Enum.ChatColor.Blue)
			end
		end
	end)
	color = color or Color3.new(31/255, 130/255, 224/255)
	pcall(function()
		local pgui = player:FindFirstChild("PlayerGui")
		if pgui == nil then return end
		local screen = Instance.new("ScreenGui")
		screen.Name = "AdmCmdNotif"
		screen.Parent = pgui
		local bg = Instance.new("Frame")
		bg.Size = UDim2.new(0, 300, 0, 64)
		bg.Position = UDim2.new(1, -320, 0, 20)
		bg.BackgroundColor3 = Color3.new(20/255, 20/255, 24/255)
		bg.BackgroundTransparency = 0.05
		bg.BorderSizePixel = 0
		bg.Parent = screen
		local accent = Instance.new("Frame")
		accent.Size = UDim2.new(0, 4, 1, 0)
		accent.BackgroundColor3 = color
		accent.BorderSizePixel = 0
		accent.Parent = bg
		local titleLbl = Instance.new("TextLabel")
		titleLbl.Size = UDim2.new(1, -16, 0, 22)
		titleLbl.Position = UDim2.new(0, 12, 0, 6)
		titleLbl.BackgroundTransparency = 1
		titleLbl.TextXAlignment = Enum.TextXAlignment.Left
		titleLbl.Font = Enum.Font.SourceSansBold
		titleLbl.TextSize = 16
		titleLbl.TextColor3 = Color3.new(1, 1, 1)
		titleLbl.Text = title
		titleLbl.Parent = bg
		local msgLbl = Instance.new("TextLabel")
		msgLbl.Size = UDim2.new(1, -16, 0, 32)
		msgLbl.Position = UDim2.new(0, 12, 0, 28)
		msgLbl.BackgroundTransparency = 1
		msgLbl.TextXAlignment = Enum.TextXAlignment.Left
		msgLbl.TextYAlignment = Enum.TextYAlignment.Top
		msgLbl.TextWrapped = true
		msgLbl.Font = Enum.Font.SourceSans
		msgLbl.TextSize = 13
		msgLbl.TextColor3 = Color3.new(0.85, 0.85, 0.85)
		msgLbl.Text = message
		msgLbl.Parent = bg
		delay(4.5, function() pcall(function() screen:Destroy() end) end)
	end)
end

local function broadcastAnnounce(message)
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		adminNotify(p, "Announcement", message, Color3.new(1, 0.7, 0.1))
	end
end

local function resolveTarget(arg)
	if arg == nil or arg == "" then return nil end
	local n = tonumber(arg)
	local players = game:GetService("Players"):GetPlayers()
	if n ~= nil then
		for _, p in ipairs(players) do
			if p.userId == n then return p end
		end
		return nil
	end
	local lower = string.lower(arg)
	for _, p in ipairs(players) do
		if string.lower(p.Name) == lower then return p end
	end
	for _, p in ipairs(players) do
		if string.sub(string.lower(p.Name), 1, string.len(lower)) == lower then return p end
	end
	return nil
end

local function postAdmin(path, payload)
	payload.authorization = "_AUTHORIZATION_STRING_"
	payload.serverId = game.JobId
	local ok, response = pcall(function()
		return game:HttpPost(url .. path, http:JSONEncode(payload), false, "application/json")
	end)
	if not ok then return false, tostring(response) end
	local decoded
	pcall(function() decoded = http:JSONDecode(response) end)
	return true, decoded
end

local maintenanceMode = false
local maintenanceReason = nil
local flyBodies = {}

-- Server-side fly that works in old RCC builds (no LocalScript injection,
-- no MoveDirection replication required).
--
-- Mechanics: a BodyVelocity is parented to the character's Torso with
-- MaxForce set on Y only - gravity stops affecting the character but X/Z
-- movement still comes from the normal Humanoid input pipeline, so WASD
-- continues to walk you around mid-air. A Heartbeat loop watches
-- Humanoid.Jump and Humanoid.Sit to convert them into vertical velocity:
--   * Jump pressed  -> ascend
--   * Sit pressed   -> descend (some clients bind this to a key, harmless
--                      otherwise; you can always toggle ;unfly to land)
-- otherwise hover. We bypass the seat behaviour by clearing Sit on the
-- next heartbeat so the avatar doesn't visibly sit while you're flying.
local FLY_VERTICAL_SPEED = 50

local function startFly(player)
	if player == nil or player.Character == nil then return end
	local hrp = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("HumanoidRootPart")
	local hum = player.Character:FindFirstChild("Humanoid")
	if hrp == nil or hum == nil then return end
	if flyBodies[player.userId] then
		pcall(function() flyBodies[player.userId].bv:Destroy() end)
		pcall(function() flyBodies[player.userId].conn:disconnect() end)
	end
	local bv = Instance.new("BodyVelocity")
	-- MaxForce on Y only: gravity is countered but normal humanoid X/Z
	-- input still pushes the character around in the air.
	bv.MaxForce = Vector3.new(0, math.huge, 0)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp
	local conn = game:GetService("RunService").Heartbeat:connect(function()
		if player == nil or player.Character == nil or hrp.Parent == nil then return end
		local up = false
		local down = false
		pcall(function() up = hum.Jump end)
		pcall(function() down = hum.Sit end)
		local vy = 0
		if up then vy = FLY_VERTICAL_SPEED end
		if down then vy = vy - FLY_VERTICAL_SPEED end
		bv.Velocity = Vector3.new(0, vy, 0)
		-- Don't actually let them sit; we're hijacking the flag for descent.
		if down then pcall(function() hum.Sit = false end) end
	end)
	flyBodies[player.userId] = { bv = bv, conn = conn }
end

local function stopFly(player)
	if player == nil then return end
	local entry = flyBodies[player.userId]
	if entry == nil then return end
	pcall(function() entry.bv:Destroy() end)
	pcall(function() entry.conn:disconnect() end)
	flyBodies[player.userId] = nil
end

local cmds = {}

cmds.fly = function(s, a)
	local t = (a[1] and resolveTarget(a[1])) or s
	if t == nil then adminNotify(s, "fly", "Target not found"); return end
	if flyBodies[t.userId] then stopFly(t); adminNotify(s, "fly", "Disabled fly for " .. t.Name)
	else startFly(t); adminNotify(s, "fly", "Enabled fly for " .. t.Name) end
end

cmds.unfly = function(s, a)
	local t = (a[1] and resolveTarget(a[1])) or s
	if t == nil then adminNotify(s, "unfly", "Target not found"); return end
	stopFly(t)
	adminNotify(s, "unfly", "Disabled fly for " .. t.Name)
end

cmds.kick = function(s, a)
	local t = resolveTarget(a[1])
	if t == nil then adminNotify(s, "kick", "Target not found"); return end
	local r = table.concat(a, " ", 2)
	if r == "" then r = "Kicked by admin" end
	pcall(function() t:Kick(r) end)
	adminNotify(s, "kick", "Kicked " .. t.Name .. ": " .. r, Color3.new(1, 0.4, 0.4))
end

cmds.ban = function(s, a)
	local id = tonumber(a[1]); if id == nil then adminNotify(s, "ban", "Usage: ;ban <userid> <reason>"); return end
	local r = table.concat(a, " ", 2); if r == "" then r = "Banned by admin" end
	local ok, resp = postAdmin("/gs/admin/ban", {actorUserId = s.userId, targetUserId = id, reason = r})
	if ok and resp and resp.ok then
		adminNotify(s, "ban", "Banned " .. id, Color3.new(1, 0.4, 0.4))
		local p = resolveTarget(tostring(id))
		if p then pcall(function() p:Kick("Banned: " .. r) end) end
	else
		adminNotify(s, "ban", "Failed: " .. tostring(resp and resp.reason or resp))
	end
end

cmds.unban = function(s, a)
	local id = tonumber(a[1]); if id == nil then adminNotify(s, "unban", "Usage: ;unban <userid>"); return end
	local ok, resp = postAdmin("/gs/admin/unban", {actorUserId = s.userId, targetUserId = id})
	if ok and resp and resp.ok then adminNotify(s, "unban", "Unbanned " .. id)
	else adminNotify(s, "unban", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.giveitem = function(s, a)
	local id = tonumber(a[1]); local aid = tonumber(a[2])
	if id == nil or aid == nil then adminNotify(s, "giveitem", "Usage: ;giveitem <userid> <itemid>"); return end
	local ok, resp = postAdmin("/gs/admin/giveitem", {actorUserId = s.userId, targetUserId = id, assetId = aid})
	if ok and resp and resp.ok then adminNotify(s, "giveitem", "Gave " .. aid .. " to " .. id)
	else adminNotify(s, "giveitem", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.removeitem = function(s, a)
	local id = tonumber(a[1]); local aid = tonumber(a[2])
	if id == nil or aid == nil then adminNotify(s, "removeitem", "Usage: ;removeitem <userid> <itemid>"); return end
	local ok, resp = postAdmin("/gs/admin/removeitem", {actorUserId = s.userId, targetUserId = id, assetId = aid})
	if ok and resp and resp.ok then adminNotify(s, "removeitem", "Removed " .. aid .. " from " .. id)
	else adminNotify(s, "removeitem", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.givecurrency = function(s, a)
	local id = tonumber(a[1]); local amt = tonumber(a[2]); local cur = a[3] or "robux"
	if id == nil or amt == nil then adminNotify(s, "givecurrency", "Usage: ;givecurrency <userid> <amt> [robux|tickets]"); return end
	local ok, resp = postAdmin("/gs/admin/givecurrency", {actorUserId = s.userId, targetUserId = id, amount = amt, currency = cur})
	if ok and resp and resp.ok then adminNotify(s, "givecurrency", "+" .. amt .. " " .. cur .. " to " .. id)
	else adminNotify(s, "givecurrency", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.announce = function(s, a)
	local msg = table.concat(a, " ")
	if msg == "" then adminNotify(s, "announce", "Usage: ;announce <message>"); return end
	broadcastAnnounce(msg)
end

cmds.shutdown = function(s, a)
	local r = table.concat(a, " "); if r == "" then r = "Server shutting down by admin" end
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		pcall(function() p:Kick(r) end)
	end
	delay(2, function() shutdown() end)
end

cmds.setrank = function(s, a)
	local id = tonumber(a[1]); local rank = a[2]
	if id == nil or rank == nil then adminNotify(s, "setrank", "Usage: ;setrank <userid> <rank>"); return end
	local ok, resp = postAdmin("/gs/admin/setrank", {actorUserId = s.userId, targetUserId = id, rank = rank})
	if ok and resp and resp.ok then adminNotify(s, "setrank", "Rank " .. rank .. " for " .. id)
	else adminNotify(s, "setrank", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.logs = function(s, a)
	local id = tonumber(a[1]); if id == nil then adminNotify(s, "logs", "Usage: ;logs <userid>"); return end
	local ok, resp = postAdmin("/gs/admin/logs", {actorUserId = s.userId, targetUserId = id})
	if ok and resp and resp.ok and resp.entries then
		local lines = {}
		for i, e in ipairs(resp.entries) do
			table.insert(lines, (e.kind or "?") .. ": " .. (e.reason or "(no reason)"))
			if i >= 5 then break end
		end
		if #lines == 0 then table.insert(lines, "No logs.") end
		adminNotify(s, "logs " .. id, table.concat(lines, "\n"))
	else adminNotify(s, "logs", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.maintenance = function(s, a)
	local mode = a[1]
	if mode == "on" then
		maintenanceMode = true
		local r = table.concat(a, " ", 2); if r == "" then r = "Server in maintenance mode" end
		maintenanceReason = r
		adminNotify(s, "maintenance", "ON: " .. r, Color3.new(1, 0.7, 0.1))
	elseif mode == "off" then
		maintenanceMode = false; maintenanceReason = nil
		adminNotify(s, "maintenance", "OFF")
	else adminNotify(s, "maintenance", "Usage: ;maintenance <on|off> [reason]") end
end

----------------------- LOCAL (server-only) admin tools -----------------------
-- These don't hit the website - they only affect the live game session.

local mutedUserIds = {}
local serverLocked = false

cmds.mute = function(s, a)
	local id = tonumber(a[1])
	if id == nil then
		local t = a[1] and resolveTarget(a[1]); if t then id = t.userId end
	end
	if id == nil then adminNotify(s, "mute", "Usage: ;mute <userid|name>"); return end
	mutedUserIds[id] = true
	adminNotify(s, "mute", "Muted " .. id .. " in this server")
end

cmds.unmute = function(s, a)
	local id = tonumber(a[1])
	if id == nil then
		local t = a[1] and resolveTarget(a[1]); if t then id = t.userId end
	end
	if id == nil then adminNotify(s, "unmute", "Usage: ;unmute <userid|name>"); return end
	mutedUserIds[id] = nil
	adminNotify(s, "unmute", "Unmuted " .. id)
end

cmds.lockserver = function(s, a)
	serverLocked = true
	adminNotify(s, "lockserver", "Server locked - new players blocked", Color3.new(1, 0.7, 0.1))
end

cmds.unlockserver = function(s, a)
	serverLocked = false
	adminNotify(s, "unlockserver", "Server unlocked")
end

local function teleportTo(target, dest)
	if target == nil or target.Character == nil then return false end
	local hrp = target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("HumanoidRootPart")
	local destHrp = dest and dest.Character and (dest.Character:FindFirstChild("Torso") or dest.Character:FindFirstChild("HumanoidRootPart"))
	if hrp == nil or destHrp == nil then return false end
	pcall(function() hrp.CFrame = destHrp.CFrame + Vector3.new(0, 4, 0) end)
	return true
end

cmds.bring = function(s, a)
	local t = resolveTarget(a[1])
	if t == nil then adminNotify(s, "bring", "Usage: ;bring <userid|name>"); return end
	if teleportTo(t, s) then adminNotify(s, "bring", "Brought " .. t.Name)
	else adminNotify(s, "bring", "Failed (target/character missing)") end
end

cmds["goto"] = function(s, a)
	local t = resolveTarget(a[1])
	if t == nil then adminNotify(s, "goto", "Usage: ;goto <userid|name>"); return end
	if teleportTo(s, t) then adminNotify(s, "goto", "Teleported to " .. t.Name)
	else adminNotify(s, "goto", "Failed (target/character missing)") end
end

cmds.teleport = function(s, a)
	-- ;teleport <who> <toUserOrName>
	local who = resolveTarget(a[1])
	local to = resolveTarget(a[2])
	if who == nil or to == nil then adminNotify(s, "teleport", "Usage: ;teleport <who> <to>"); return end
	if teleportTo(who, to) then adminNotify(s, "teleport", who.Name .. " -> " .. to.Name)
	else adminNotify(s, "teleport", "Failed (character missing)") end
end

local function reloadCharacter(target)
	if target == nil then return false end
	local ok = pcall(function() target:LoadCharacter() end)
	return ok
end

cmds.refresh = function(s, a)
	local t = (a[1] and resolveTarget(a[1])) or s
	if t == nil then adminNotify(s, "refresh", "Target not found"); return end
	if reloadCharacter(t) then adminNotify(s, "refresh", "Reloaded " .. t.Name)
	else adminNotify(s, "refresh", "Failed") end
end

cmds.resetcharacter = cmds.refresh
cmds.forceavatarreload = cmds.refresh

----------------------- BACKEND-BACKED admin commands -----------------------

cmds.warn = function(s, a)
	local id = tonumber(a[1]); if id == nil then adminNotify(s, "warn", "Usage: ;warn <userid> <reason>"); return end
	local r = table.concat(a, " ", 2); if r == "" then r = "Warned by admin" end
	local ok, resp = postAdmin("/gs/admin/warn", {actorUserId = s.userId, targetUserId = id, reason = r})
	if ok and resp and resp.ok then
		adminNotify(s, "warn", "Warned " .. id .. ": " .. r, Color3.new(1, 0.7, 0.1))
		local p = resolveTarget(tostring(id))
		if p then adminNotify(p, "Warning", r, Color3.new(1, 0.4, 0.4)) end
	else adminNotify(s, "warn", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

cmds.removecurrency = function(s, a)
	local id = tonumber(a[1]); local amt = tonumber(a[2]); local cur = a[3] or "robux"
	if id == nil or amt == nil then adminNotify(s, "removecurrency", "Usage: ;removecurrency <userid> <amt> [robux|tickets]"); return end
	local ok, resp = postAdmin("/gs/admin/removecurrency", {actorUserId = s.userId, targetUserId = id, amount = amt, currency = cur})
	if ok and resp and resp.ok then adminNotify(s, "removecurrency", "-" .. tostring(resp.amount or amt) .. " " .. cur .. " from " .. id)
	else adminNotify(s, "removecurrency", "Failed: " .. tostring(resp and resp.reason or resp)) end
end

