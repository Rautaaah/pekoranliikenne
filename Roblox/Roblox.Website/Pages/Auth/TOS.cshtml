@page "/auth/tos"
@model Roblox.Website.Pages.Auth.TOS

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Terms of Service</title>
    <link rel="icon" type="image/png" href="/img/sansy-icon-square.png">
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; font-family: Arial, sans-serif; color: #f3f7ff; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #0d2231;
            background-image: linear-gradient(rgba(5, 18, 30, 0.48), rgba(5, 18, 30, 0.62)), url('/img/landing/signupbackground.png');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center center;
        }
        .topbar { width: 100%; padding: 18px 24px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .brand { display: inline-flex; align-items: center; }
        .brand img { width: 42px; height: 42px; object-fit: contain; }
        .links { display: flex; align-items: center; justify-content: flex-end; gap: 18px; flex-wrap: wrap; font-size: 15px; }
        .links a { color: #f4f7ff; text-decoration: none; text-shadow: 0 2px 10px rgba(0,0,0,0.45); }
        .links a:hover { text-decoration: underline; }
        .shell { flex: 1; width: 100%; max-width: 1440px; margin: 0 auto; padding: 38px 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 56px; }
        .hero { flex: 1 1 58%; display: flex; align-items: center; justify-content: center; min-height: 420px; padding: 0 18px; }
        .hero img { width: 100%; max-width: 680px; object-fit: contain; filter: drop-shadow(0 20px 34px rgba(0,0,0,0.36)); }
        .card {
            width: 100%;
            max-width: 520px;
            max-height: min(78vh, 900px);
            overflow: auto;
            background: rgba(255,255,255,0.97);
            color: #332723;
            border-radius: 8px;
            padding: 28px 26px 22px;
            border: 1px solid rgba(255,255,255,0.58);
            box-shadow: 0 30px 72px rgba(6, 15, 24, 0.34), 0 10px 24px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255,255,255,0.72);
        }
        .card h1 { margin: 0 0 12px; text-align: center; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; color: #201814; }
        .card p, .card li { font-size: 15px; line-height: 1.55; color: #554540; }
        .card p { margin: 0 0 14px; }
        .card ul { margin: 0 0 16px 20px; padding: 0; }
        .card a { color: #167dff; }
        .muted { font-size: 14px; color: #7b6d67; }
        .footer { padding: 10px 14px 14px; text-align: center; font-size: 12px; color: #f2f7ff; text-shadow: 0 3px 14px rgba(0,0,0,0.55); }
        @@media (max-width: 980px) {
            .topbar { padding: 14px 16px 0; }
            .shell { padding: 26px 16px 22px; flex-direction: column; justify-content: center; gap: 28px; }
            .hero { min-height: 0; padding: 0; }
            .hero img { max-width: 520px; }
            .card { max-width: 720px; max-height: none; }
        }
    </style>
</head>
<body>
<div class="topbar">
    <a class="brand" href="/"><img alt="Sansy" src="/img/sansy-icon-square.png"></a>
    <div class="links">
        <a href="/auth/home">Home</a>
        <a href="/">Login</a>
        <a href="/auth/tos">Terms of Service</a>
        <a href="/auth/privacy">Privacy</a>
        <a href="/auth/account-deletion">Account Deletion</a>
        <a href="/auth/donate">Donate</a>
    </div>
</div>
<main class="shell">
    <div class="hero">
        <img alt="Sansy" src="/img/sansy-logo-full.png">
    </div>
    <div class="card">
        <h1>Terms of Service</h1>
        <p class="muted">Last Updated April 23, 2026</p>
        <p>These Terms govern use of Sansy. By creating an account, logging in, or using any Sansy service, you agree to follow these Terms and our <a href="/auth/privacy">Privacy Policy</a>.</p>
        <p><strong>1. Account Rules</strong></p>
        <ul>
            <li>You are responsible for activity on your account and for keeping your password secure.</li>
            <li>Impersonation, account sharing for abuse, and unauthorized account access are prohibited.</li>
            <li>Staff may suspend, limit, or terminate accounts that violate these Terms.</li>
        </ul>
        <p><strong>2. Conduct and Safety</strong></p>
        <ul>
            <li>Harassment, hate speech, threats, doxxing, and attempts to intimidate others are prohibited.</li>
            <li>Sexual content involving minors, exploitation content, or instructions for abuse are prohibited.</li>
            <li>Spam, scams, malicious links, phishing, and deceptive promotions are prohibited.</li>
        </ul>
        <p><strong>3. Content Standards</strong></p>
        <ul>
            <li>Do not upload illegal, stolen, infringing, or non-consensual content.</li>
            <li>Graphic gore, pornography, and content designed to shock or bypass moderation are prohibited.</li>
            <li>You keep ownership of your original submissions, but you grant Sansy the right to host and display them for platform operation.</li>
        </ul>
        <p><strong>4. Platform Integrity</strong></p>
        <ul>
            <li>Do not exploit bugs, bypass security, automate abuse, reverse-engineer for malicious use, or interfere with services.</li>
            <li>Do not create or use alts to evade moderation, cooldowns, limits, or enforcement actions.</li>
            <li>Attempts to manipulate economy systems, rewards, or trading systems may result in immediate account action.</li>
        </ul>
        <p><strong>5. Enforcement</strong></p>
        <ul>
            <li>Moderation actions may include warning, content removal, temporary suspension, feature restrictions, or permanent termination.</li>
            <li>Severe violations can result in immediate permanent action without prior warning.</li>
            <li>Sansy may preserve moderation evidence as needed for safety and abuse prevention.</li>
        </ul>
        <p><strong>6. Availability and Changes</strong></p>
        <ul>
            <li>Services may change, pause, or end at any time, including during maintenance and security incidents.</li>
            <li>We may update these Terms; continued use after updates means you accept the revised Terms.</li>
        </ul>
    </div>
</main>
<div class="footer">(c) @DateTime.UtcNow.Year Sansy. Not affiliated with Roblox Corporation.</div>
</body>
</html>
