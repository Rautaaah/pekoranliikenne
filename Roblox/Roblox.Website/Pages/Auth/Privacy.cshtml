@page "/auth/privacy"
@model Roblox.Website.Pages.Auth.Privacy

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Privacy Information</title>
    <link rel="icon" type="image/png" href="/img/sansy-icon-square.png">
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; font-family: Arial, sans-serif; color: #f3f7ff; }
        body { min-height: 100vh; display: flex; flex-direction: column; background-color: #0d2231; background-image: linear-gradient(rgba(5, 18, 30, 0.48), rgba(5, 18, 30, 0.62)), url('/img/landing/signupbackground.png'); background-repeat: no-repeat; background-size: cover; background-position: center center; }
        .topbar { width: 100%; padding: 18px 24px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .brand { display: inline-flex; align-items: center; }
        .brand img { width: 42px; height: 42px; object-fit: contain; }
        .links { display: flex; align-items: center; justify-content: flex-end; gap: 18px; flex-wrap: wrap; font-size: 15px; }
        .links a { color: #f4f7ff; text-decoration: none; text-shadow: 0 2px 10px rgba(0,0,0,0.45); }
        .links a:hover { text-decoration: underline; }
        .shell { flex: 1; width: 100%; max-width: 1440px; margin: 0 auto; padding: 38px 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 56px; }
        .hero { flex: 1 1 58%; display: flex; align-items: center; justify-content: center; min-height: 420px; padding: 0 18px; }
        .hero img { width: 100%; max-width: 680px; object-fit: contain; filter: drop-shadow(0 20px 34px rgba(0,0,0,0.36)); }
        .card { width: 100%; max-width: 520px; max-height: min(78vh, 900px); overflow: auto; background: rgba(255,255,255,0.97); color: #332723; border-radius: 8px; padding: 28px 26px 22px; border: 1px solid rgba(255,255,255,0.58); box-shadow: 0 30px 72px rgba(6, 15, 24, 0.34), 0 10px 24px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255,255,255,0.72); }
        .card h1 { margin: 0 0 12px; text-align: center; font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; color: #201814; }
        .card p, .card li { font-size: 15px; line-height: 1.55; color: #554540; }
        .card p { margin: 0 0 14px; }
        .card ul { margin: 0 0 16px 20px; padding: 0; }
        .card a { color: #167dff; }
        .muted { font-size: 14px; color: #7b6d67; }
        .footer { padding: 10px 14px 14px; text-align: center; font-size: 12px; color: #f2f7ff; text-shadow: 0 3px 14px rgba(0,0,0,0.55); }
        @@media (max-width: 980px) { .topbar { padding: 14px 16px 0; } .shell { padding: 26px 16px 22px; flex-direction: column; justify-content: center; gap: 28px; } .hero { min-height: 0; padding: 0; } .hero img { max-width: 520px; } .card { max-width: 720px; max-height: none; } }
    </style>
</head>
<body>
<div class="topbar">
    <a class="brand" href="/"><img alt="Sansy" src="/img/sansy-icon-square.png"></a>
    <div class="links">
        <a href="/auth/home">Home</a>
        <a href="/">Login</a>
        <a href="/auth/tos">Terms of Service</a>
        <a href="/auth/privacy">Privacy</a>
        <a href="/auth/account-deletion">Account Deletion</a>
        <a href="/auth/donate">Donate</a>
    </div>
</div>
<main class="shell">
    <div class="hero">
        <img alt="Sansy" src="/img/sansy-logo-full.png">
    </div>
    <div class="card">
        <h1>Privacy Information</h1>
        <p class="muted">Last Updated April 23, 2026</p>
        <p>This Privacy Policy explains what information Sansy collects, how it is used, and how you can request changes or deletion.</p>
        <p><strong>1. Information We Collect</strong></p>
        <ul>
            <li>Account details such as username, email address, password hash, account timestamps, and profile content.</li>
            <li>Security and session data such as login attempts, session identifiers, and anti-abuse telemetry.</li>
            <li>User-generated content such as uploads, posts, reports, and in-platform interactions.</li>
            <li>Technical data such as browser type, device metadata, and network/IP-derived anti-abuse signals.</li>
        </ul>
        <p><strong>2. How We Use Information</strong></p>
        <ul>
            <li>To provide account access, gameplay features, moderation, support, and platform operations.</li>
            <li>To detect spam, fraud, exploit attempts, abuse patterns, and other security threats.</li>
            <li>To enforce our <a href="/auth/tos">Terms of Service</a> and maintain platform integrity.</li>
        </ul>
        <p><strong>3. Sharing and Disclosure</strong></p>
        <ul>
            <li>Sansy does not sell personal data.</li>
            <li>Data may be shared with infrastructure providers strictly for hosting, delivery, and abuse mitigation.</li>
            <li>Data may be disclosed when required by law or when necessary to protect the platform and users.</li>
        </ul>
        <p><strong>4. Retention</strong></p>
        <ul>
            <li>We retain data for as long as needed for operations, safety, moderation, and legal compliance.</li>
            <li>Certain moderation and security logs may be retained after account closure to prevent repeated abuse.</li>
        </ul>
        <p><strong>5. Your Choices</strong></p>
        <ul>
            <li>You may request account deletion at <a href="/auth/account-deletion">Account Deletion</a>.</li>
            <li>You may request corrections to account information by contacting platform staff.</li>
        </ul>
        <p><strong>6. Third-Party Services</strong></p>
        <p>Sansy may rely on third-party providers (for example, CDN, DDoS protection, and infrastructure). Their handling of data is governed by their own privacy policies.</p>
        <p><strong>7. Policy Updates</strong></p>
        <p>We may revise this Privacy Policy from time to time. Continued use of Sansy after updates means the updated policy applies.</p>
    </div>
</main>
<div class="footer">(c) @DateTime.UtcNow.Year Sansy. Not affiliated with Roblox Corporation.</div>
</body>
</html>
